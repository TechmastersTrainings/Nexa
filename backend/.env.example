# Environment Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Nexa Women Safety Intelligence Platform"
API_V1_PREFIX="/api/v1"

# Security
# Generate secure 64-character secret key for JWT signing
SECRET_KEY=nexa_women_safety_assistant_super_secure_jwt_secret_key_prod_grade_2026_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (PostgreSQL 17)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_secure_password_2026
POSTGRES_DB=nexa_safety_db
DATABASE_URL=postgresql+psycopg2://nexa_user:nexa_secure_password_2026@127.0.0.1:5432/nexa_safety_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://10.0.2.2:8000"]

# Emergency Notification Gateway (Twilio - configured in Phase 5)
TWILIO_ACCOUNT_SID=AC_dev_placeholder_sid
TWILIO_AUTH_TOKEN=dev_placeholder_token
TWILIO_FROM_PHONE=+10000000000
EMERGENCY_SMS_ENABLED=False
